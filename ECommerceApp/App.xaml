<Application x:Class="ECommerceApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ECommerceApp"
             xmlns:converters="clr-namespace:ECommerceApp.Converters"
             xmlns:views="clr-namespace:ECommerceApp.Views"
             xmlns:vm="clr-namespace:ECommerceApp.ViewModels"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Converters -->
            <converters:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisibility"/>
            <converters:StringToVisibilityConverter x:Key="StringToVisibility"/>
            <converters:PriceToCurrencyConverter x:Key="PriceToCurrency"/>
            <converters:StockStatusConverter x:Key="StockStatus"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

            <!-- View-ViewModel DataTemplates -->
            <DataTemplate DataType="{x:Type vm:LoginViewModel}">
                <views:LoginView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StoreOwnerDashboardViewModel}">
                <views:StoreOwnerDashboardView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CustomerShopViewModel}">
                <views:CustomerShopView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CustomerServiceViewModel}">
                <views:CustomerServiceView/>
            </DataTemplate>

            <!-- Global Styles -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI"/>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="FontFamily" Value="Segoe UI"/>
            </Style>

            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="Segoe UI"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
