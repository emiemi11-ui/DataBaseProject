<UserControl x:Class="ECommerceApp.Views.StoreOwnerDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:ECommerceApp.Views"
             xmlns:vm="clr-namespace:ECommerceApp.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#F5F5F5">

    <UserControl.Resources>
        <!-- Navigation Button Style -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E8E8E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Logout Button Style -->
        <Style x:Key="LogoutButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F44336"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D32F2F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Content Templates -->
        <DataTemplate DataType="{x:Type vm:ProductManagementViewModel}">
            <local:ProductManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryManagementViewModel}">
            <local:InventoryManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OrderManagementViewModel}">
            <local:OrderManagementView/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" Direction="0"/>
            </Border.Effect>

            <DockPanel>
                <!-- Header -->
                <StackPanel DockPanel.Dock="Top" Margin="15,20,15,30">
                    <TextBlock Text="E-Commerce"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#333333"/>
                    <TextBlock Text="Store Owner Dashboard"
                               FontSize="12"
                               Foreground="#666666"
                               Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding WelcomeMessage}"
                               FontSize="11"
                               Foreground="#4CAF50"
                               Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Logout Button at Bottom -->
                <Button DockPanel.Dock="Bottom"
                        Content="Logout"
                        Style="{StaticResource LogoutButtonStyle}"
                        Command="{Binding LogoutCommand}"
                        Margin="15,0,15,20"/>

                <!-- Navigation Buttons -->
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="MANAGEMENT"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#999999"
                               Margin="15,0,0,10"/>

                    <Button Content="📦  Products"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateToProductsCommand}"/>

                    <Button Content="📊  Inventory"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateToInventoryCommand}"/>

                    <Button Content="📋  Orders"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateToOrdersCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Column="1" Margin="20">
            <ContentControl Content="{Binding CurrentContentViewModel}"/>
        </Border>
    </Grid>
</UserControl>
