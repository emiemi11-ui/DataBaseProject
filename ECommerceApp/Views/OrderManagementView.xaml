<UserControl x:Class="ECommerceApp.Views.OrderManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="700"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45A049"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Order Management"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#333333"/>
            <TextBlock Text="View and manage customer orders"
                       FontSize="12"
                       Foreground="#666666"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Filter Bar -->
        <Border Grid.Row="1" Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Filter by Status:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding SelectedStatusFilter}"
                          Width="150"
                          Padding="10,8"/>
                <Button Content="Apply Filter"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#2196F3"
                        Command="{Binding FilterByStatusCommand}"
                        Margin="10,0,0,0"/>
                <Button Content="Show All"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#757575"
                        Command="{Binding RefreshCommand}"
                        Margin="5,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="150"/>
            </Grid.RowDefinitions>

            <!-- Orders Grid -->
            <Border Grid.Row="0" Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,10">
                <DataGrid ItemsSource="{Binding Orders}"
                          SelectedItem="{Binding SelectedOrder}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Order #" Binding="{Binding OrderID}" Width="70"/>
                        <DataGridTextColumn Header="Customer" Binding="{Binding Customer.Username}" Width="120"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding OrderDate, StringFormat=MM/dd/yyyy HH:mm}" Width="130"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat=C2}" Width="100"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding OrderStatus}" Width="100"/>
                        <DataGridTemplateColumn Header="Actions" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Process"
                                                Style="{StaticResource ActionButtonStyle}"
                                                Command="{Binding DataContext.UpdateStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="Processing"/>
                                        <Button Content="Ship"
                                                Style="{StaticResource ActionButtonStyle}"
                                                Background="#2196F3"
                                                Command="{Binding DataContext.UpdateStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="Shipped"/>
                                        <Button Content="Deliver"
                                                Style="{StaticResource ActionButtonStyle}"
                                                Background="#9C27B0"
                                                Command="{Binding DataContext.UpdateStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="Delivered"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <TextBlock Grid.Row="1" Text="Order Details:" FontWeight="SemiBold" Margin="0,5"/>

            <!-- Order Details -->
            <Border Grid.Row="2" Background="White" CornerRadius="5" Padding="15">
                <DataGrid ItemsSource="{Binding OrderDetails}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Product" Binding="{Binding Product.ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="80"/>
                        <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat=C2}" Width="100"/>
                        <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=C2}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Messages -->
        <StackPanel Grid.Row="3" Margin="0,15,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#F44336" FontSize="12"/>
            <TextBlock Text="{Binding SuccessMessage}" Foreground="#4CAF50" FontSize="12"/>
        </StackPanel>
    </Grid>
</UserControl>
