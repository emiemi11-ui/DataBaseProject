<UserControl x:Class="ECommerceApp.Views.ShoppingCartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="700"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45A049"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#BDBDBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Shopping Cart"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#333333"/>
            <Button Content="Continue Shopping"
                    Style="{StaticResource ActionButtonStyle}"
                    Background="#757575"
                    Padding="12,8"
                    HorizontalAlignment="Left"
                    Command="{Binding ContinueShoppingCommand}"
                    Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Cart Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Cart Items -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,20,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1"/>
                </Border.Effect>
                <Grid>
                    <!-- Empty Cart Message -->
                    <StackPanel Visibility="{Binding IsCartEmpty, Converter={StaticResource BoolToVisibility}}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="Your cart is empty"
                                   FontSize="18"
                                   Foreground="#999999"
                                   HorizontalAlignment="Center"/>
                        <Button Content="Start Shopping"
                                Style="{StaticResource ActionButtonStyle}"
                                Command="{Binding ContinueShoppingCommand}"
                                Margin="0,20,0,0"/>
                    </StackPanel>

                    <!-- Cart Items List -->
                    <ListView ItemsSource="{Binding CartItems}"
                              BorderThickness="0"
                              Visibility="{Binding IsCartEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0,10"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Product Info -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding ProductName}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding UnitPrice, StringFormat='Unit Price: {0:C2}'}"
                                                       FontSize="12"
                                                       Foreground="#666666"
                                                       Margin="0,5,0,0"/>
                                        </StackPanel>

                                        <!-- Quantity -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Qty:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="50"
                                                     Padding="8,5"
                                                     TextAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Subtotal -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Subtotal, StringFormat=C2}"
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>

                                        <!-- Remove Button -->
                                        <Button Grid.Column="3"
                                                Content="Remove"
                                                Background="#F44336"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Padding="10,5"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Order Summary -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20" VerticalAlignment="Top">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Order Summary"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,20"/>

                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,10">
                        <Grid>
                            <TextBlock Text="Subtotal"/>
                            <TextBlock Text="{Binding FormattedTotal}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,10">
                        <Grid>
                            <TextBlock Text="Shipping"/>
                            <TextBlock Text="Free" HorizontalAlignment="Right" Foreground="#4CAF50"/>
                        </Grid>
                    </Border>

                    <Grid Margin="0,15,0,20">
                        <TextBlock Text="Total" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="{Binding FormattedTotal}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#4CAF50"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Shipping Address -->
                    <TextBlock Text="Shipping Address"
                               FontSize="12"
                               Foreground="#666666"
                               Margin="0,0,0,5"/>
                    <TextBox Text="{Binding ShippingAddress, UpdateSourceTrigger=PropertyChanged}"
                             Height="80"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Padding="10"
                             Margin="0,0,0,15"/>

                    <!-- Place Order Button -->
                    <Button Content="Place Order"
                            Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding PlaceOrderCommand}"
                            HorizontalAlignment="Stretch"/>

                    <!-- Clear Cart -->
                    <Button Content="Clear Cart"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#757575"
                            Command="{Binding ClearCartCommand}"
                            HorizontalAlignment="Stretch"
                            Margin="0,10,0,0"/>

                    <!-- Messages -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#F44336"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,15,0,0"/>
                    <TextBlock Text="{Binding SuccessMessage}"
                               Foreground="#4CAF50"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
