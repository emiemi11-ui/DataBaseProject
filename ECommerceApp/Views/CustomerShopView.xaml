<UserControl x:Class="ECommerceApp.Views.CustomerShopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:ECommerceApp.Views"
             xmlns:vm="clr-namespace:ECommerceApp.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#F5F5F5">

    <UserControl.Resources>
        <!-- Button Styles -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E8E8E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CartButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45A049"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Content Templates -->
        <DataTemplate DataType="{x:Type vm:ShoppingCartViewModel}">
            <local:ShoppingCartView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OrderHistoryViewModel}">
            <local:OrderHistoryView/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation Bar -->
        <Border Grid.Row="0" Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>
            <Grid Margin="20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="E-Commerce"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding WelcomeMessage}"
                               FontSize="12"
                               Foreground="#666666"
                               VerticalAlignment="Center"
                               Margin="20,0,0,0"/>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Shop"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding ViewShopCommand}"/>
                    <Button Content="My Orders"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding ViewOrdersCommand}"/>
                </StackPanel>

                <!-- Cart and Logout -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource CartButtonStyle}"
                            Command="{Binding ViewCartCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Cart"/>
                            <Border Background="#FF5722" CornerRadius="10" Padding="6,2" Margin="8,0,0,0">
                                <TextBlock Text="{Binding CartItemCount}" FontSize="11" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Content="Logout"
                            Style="{StaticResource NavButtonStyle}"
                            Foreground="#F44336"
                            Command="{Binding LogoutCommand}"
                            Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <!-- Shop View (when no content ViewModel) -->
            <Grid Visibility="{Binding CurrentContentViewModel, Converter={StaticResource NullToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search and Filter Bar -->
                <Border Grid.Row="0" Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search -->
                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="300"
                                     Padding="10,8"
                                     FontSize="12"/>
                            <Button Content="Search"
                                    Style="{StaticResource CartButtonStyle}"
                                    Background="#2196F3"
                                    Command="{Binding SearchCommand}"
                                    Margin="10,0,0,0"/>
                        </StackPanel>

                        <!-- Category Filter -->
                        <StackPanel Orientation="Horizontal" Grid.Column="1">
                            <TextBlock Text="Category:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding SelectedCategory}"
                                      DisplayMemberPath="CategoryName"
                                      Width="150"
                                      Padding="8"/>
                            <Button Content="Filter"
                                    Style="{StaticResource CartButtonStyle}"
                                    Background="#FF9800"
                                    Command="{Binding FilterByCategoryCommand}"
                                    Margin="10,0,0,0"/>
                            <Button Content="Clear"
                                    Style="{StaticResource CartButtonStyle}"
                                    Background="#757575"
                                    Command="{Binding ClearFilterCommand}"
                                    Margin="5,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Products Grid -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Products}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                        CornerRadius="8"
                                        Width="220"
                                        Margin="0,0,15,15"
                                        Padding="15">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <!-- Product Image Placeholder -->
                                        <Border Background="#E0E0E0"
                                                Height="120"
                                                CornerRadius="5"
                                                Margin="0,0,0,12">
                                            <TextBlock Text="Image"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="#999999"/>
                                        </Border>

                                        <!-- Category -->
                                        <TextBlock Text="{Binding Category.CategoryName}"
                                                   FontSize="11"
                                                   Foreground="#666666"/>

                                        <!-- Product Name -->
                                        <TextBlock Text="{Binding ProductName}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Height="40"
                                                   Margin="0,5,0,8"/>

                                        <!-- Price -->
                                        <TextBlock Text="{Binding Price, StringFormat=C2}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="#4CAF50"
                                                   Margin="0,0,0,8"/>

                                        <!-- Stock Info -->
                                        <TextBlock FontSize="11" Margin="0,0,0,10">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Inventory.StockQuantity, StringFormat='In Stock: {0}'}"/>
                                                    <Setter Property="Foreground" Value="#666666"/>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Add to Cart Button -->
                                        <Button Content="Add to Cart"
                                                Style="{StaticResource CartButtonStyle}"
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Content View (Cart or Orders) -->
            <ContentControl Content="{Binding CurrentContentViewModel}"
                            Visibility="{Binding CurrentContentViewModel, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}"/>
        </Grid>

        <!-- Messages -->
        <Border Grid.Row="1"
                Background="#E8F5E9"
                CornerRadius="5"
                Padding="15,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,10,0,0"
                Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding SuccessMessage}" Foreground="#2E7D32"/>
        </Border>

        <Border Grid.Row="1"
                Background="#FFEBEE"
                CornerRadius="5"
                Padding="15,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,10,0,0"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828"/>
        </Border>
    </Grid>
</UserControl>
